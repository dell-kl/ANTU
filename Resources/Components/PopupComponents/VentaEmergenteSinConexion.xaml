<?xml version="1.0" encoding="utf-8"?>
<mopup:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                            xmlns:mopup="clr-namespace:Mopups.Pages;assembly=Mopups"
                            x:Class="ANTU.Resources.Components.PopupComponents.VentaEmergenteSinConexion"
                            BackgroundColor="#FFFF"
                            CloseWhenBackgroundIsClicked="False">
    <VerticalStackLayout
        VerticalOptions="Center">
        <Image
            HeightRequest="270"
            Source="{Binding Path=Icono}"/>

        <Button
            Margin="0,10,0,0"
            x:Name="BotonReintentar"
            Text="Reintentar"
            FontFamily="SegoeUILight"
            FontAttributes="Bold"
            WidthRequest="120"
            TextColor="#FFF"
            BackgroundColor="DarkOrange"
            Command="{Binding Path=Command}"/>
        
        <Label VerticalOptions="Center"
               WidthRequest="250"
               Margin="0,10,0,0"
               HorizontalTextAlignment="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span
                        TextColor="red"
                        Text="&#xe78f;"
                        FontSize="20"
                        FontAttributes="Bold"
                        FontFamily="MaterialAssets"/>
                    <Span
                        FontFamily="SegoeUILight"
                        x:Name="Contenido"
                        Text="{Binding Path=Descripcion}"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="red"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </VerticalStackLayout>
</mopup:PopupPage>